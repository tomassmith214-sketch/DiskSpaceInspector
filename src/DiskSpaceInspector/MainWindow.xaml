<Window x:Class="DiskSpaceInspector.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskSpaceInspector" xmlns:charts="clr-namespace:DiskSpaceInspector.Controls" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="1220" Height="760" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True">
 <Grid Margin="24,20,20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="{Binding Title}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding T.Subtitle}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="{DynamicResource InputBrush}" CornerRadius="16" Padding="13,7" Margin="0,0,12,0"><TextBlock Text="{Binding T.ReadOnlyMode}" Foreground="{DynamicResource AccentBrush}"/></Border><Button Content="{Binding T.LanguageButton}" Command="{Binding ToggleLanguageCommand}" Margin="0,0,8,0" ToolTip="Language"/><Button Content="{Binding T.Theme}" Click="ToggleTheme" ToolTip="{Binding T.ThemeTip}"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,12" Padding="14">
   <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><ComboBox Width="84" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding ExportFormat}" Margin="0,0,8,0"/><Button Content="{Binding T.ExportReport}" Command="{Binding ExportCommand}" ToolTip="{Binding T.ExportTip}"/></StackPanel>
     <ComboBox Width="86" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding CanChooseDrive}" Margin="0,0,10,0" ToolTip="{Binding T.LocalDrive}"/>
     <Button Content="{Binding ScanLabel}" Command="{Binding ScanCommand}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Margin="0,0,8,0"/>
     <Button Content="{Binding T.Stop}" Command="{Binding StopCommand}"/>
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="0,12,0,0"><ProgressBar Height="3" IsIndeterminate="{Binding IsScanning}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0"/><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding CurrentPath}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentPath}" Margin="0,0,18,0"/><TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{DynamicResource MutedBrush}"/></Grid></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,18,0"/><TextBlock Grid.Column="1" Text="{Binding ResultLabel}" Foreground="{DynamicResource AccentBrush}"/></Grid>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
   <TabControl x:Name="MainTabs">
    <TabItem Header="{Binding T.Overview}">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
      <ItemsControl ItemsSource="{Binding Metrics}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="{Binding Label}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Value}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,5"/><TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="{Binding T.UpOneLevel}" Command="{Binding UpCommand}" Padding="10,5"/><TextBlock Text="{Binding T.SpaceMap}" Style="{StaticResource Section}"/></DockPanel><TextBlock Text="{Binding MapPath}" Style="{StaticResource Muted}" Margin="0,0,0,12"/><charts:SpaceChart x:Name="MapChart" Entries="{Binding Map}" Height="305"/><TextBlock Text="{Binding T.SpaceHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="100" ItemsSource="{Binding ChartModes}" SelectedItem="{Binding ChartMode}"/><TextBlock Text="Top 20" Style="{StaticResource Section}"/></DockPanel><TextBlock Text="{Binding T.OverlapHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,16"/><charts:SpaceChart x:Name="TopChart" Entries="{Binding Top}" Mode="Bars" Height="660"/></StackPanel></Border>
       <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T.Composition}" Style="{StaticResource Section}"/><charts:SpaceChart x:Name="CompositionChart" Entries="{Binding Donut}" Mode="Donut" Height="225"/><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,8,0,10"><TextBlock Text="{Binding FocusText, ElementName=CompositionChart}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border><ItemsControl ItemsSource="{Binding CategoryData}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="9" Height="9" CornerRadius="3" Background="{Binding Color}" HorizontalAlignment="Left"/><TextBlock Grid.Column="1" Text="{Binding Category}"/><TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource MutedBrush}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T.MainCauses}" Style="{StaticResource Section}"/><TextBlock Text="{Binding Causes}" TextWrapping="Wrap" LineHeight="24"/></StackPanel></Border>
       </StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{Binding T.ManualCandidates}" Style="{StaticResource Section}"/><TextBlock Text="{Binding T.ManualHint}" Style="{StaticResource Muted}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding PreviewRecommendations}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/><TextBlock Text="{Binding Reason}" Style="{StaticResource Muted}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="{Binding T.FoldersTab}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ContentControl Content="{Binding}" ContentTemplate="{DynamicResource FilterPanel}"/>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Padding="8" Margin="0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding T.TreeHeader}" Foreground="{DynamicResource MutedBrush}" Margin="8,8,8,12"/><TreeView ItemsSource="{Binding Tree}" SelectedItemChanged="TreeSelection"><TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Label}"/></HierarchicalDataTemplate></TreeView.ItemTemplate></TreeView></DockPanel></Border>
       <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}"/>
       <DataGrid Grid.Column="2" ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected}" MouseDoubleClick="FolderDoubleClick" ToolTip="{Binding T.FolderDoubleClickTip}"><DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Folder, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Size, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding FileCount}" Width="85"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Files, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding FolderCount}" Width="85"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Folders, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding PercentText}" SortMemberPath="PercentUsed" Width="90"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.UsedPercent, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding FullPath}" Width="330" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.FullPath, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Modified, StringFormat={}{0:g}}" Width="135"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Modified, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Status}" Width="230" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Access, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       </DataGrid.Columns></DataGrid>
      </Grid>
     </Grid>
    </TabItem>
    <TabItem Header="{Binding T.FilesTab}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><ContentControl Content="{Binding}" ContentTemplate="{DynamicResource FilterPanel}"/>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}"><DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding Name}" Width="220" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.FileName, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Size, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Extension}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Extension, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Category}" Width="145"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Category, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding FullPath}" Width="350" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.FullPath, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Modified, StringFormat={}{0:g}}" Width="135"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Modified, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding ParentPath}" Width="300" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.ParentFolder, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Purpose}" Width="180"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Purpose, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Risk}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Risk, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     </DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="{Binding T.FileTypesTab}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel Margin="0,0,0,16"><TextBlock Text="{Binding T.TypesTitle}" Style="{StaticResource Section}"/><TextBlock Text="{Binding T.TypesHint}" Style="{StaticResource Muted}"/></StackPanel>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Extensions}" SelectionChanged="ExtensionSelection"><DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding Extension}" Width="125"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Extension, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Category}" Width="150"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Category, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Count}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Count, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Total, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding AverageText}" SortMemberPath="Average" Width="105"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Average, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding LargestText}" SortMemberPath="Largest" Width="105"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Maximum, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding LargestPath}" Width="340" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.LargestFile, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding ExamplesText}" Width="340" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.ExamplePaths, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     </DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="{Binding T.ProgramsTab}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{Binding T.ProgramsHint}" Style="{StaticResource Muted}" Margin="0,0,0,12"/><ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{DynamicResource FilterPanel}"/>
     <DataGrid Grid.Row="2" ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}"><DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.ProgramFolder, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Size, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Category}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Category, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Risk}" Width="125"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Risk, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding FullPath}" Width="330" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.FullPath, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Advice}" Width="450" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.WhatToCheck, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     </DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="{Binding T.RecommendationsTab}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding T.RecommendationsTitle}" Style="{StaticResource Section}"/><TextBlock Text="{Binding T.RecommendationsWarning}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding T.RecommendationsLimit}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
     <DataGrid Grid.Row="1" ItemsSource="{Binding Recommendations}" SelectionChanged="RecommendationSelection"><DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding FullPath}" Width="310" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.FullPath, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding SizeText}" SortMemberPath="Size" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Size, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Category}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Category, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Risk}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Risk, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Reason}" Width="310" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Reason, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Check}" Width="450" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.WhatToCheck, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Warning}" Width="450" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Warning, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     </DataGrid.Columns></DataGrid>
     <StackPanel Grid.Row="2" Margin="0,18,0,10"><TextBlock Text="{Binding T.IssuesTitle}" Style="{StaticResource Section}" Margin="0,0,0,6"/><TextBlock Text="{Binding T.IssuesHint}" Style="{StaticResource Muted}"/></StackPanel>
     <DataGrid Grid.Row="3" ItemsSource="{Binding Issues}"><DataGrid.Columns><DataGridTextColumn Binding="{Binding FullPath}" Width="400" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.FullPath, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Binding="{Binding Reason}" Width="*" ElementStyle="{StaticResource CellText}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.T.Reason, RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
    </Grid></TabItem>
   </TabControl>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent"/>
   <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,0" Padding="16"><DockPanel>
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding T.ObjectDetails}" Style="{StaticResource Section}"/><TextBox Text="{Binding Selected.FullPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" FontWeight="SemiBold"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><Button Content="{Binding T.CopyPath}" Command="{Binding CopyCommand}" Margin="0,0,0,8"/><Button Content="{Binding T.OpenExplorer}" Command="{Binding ExplorerCommand}"/><TextBlock Text="{Binding T.MetadataOnly}" Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" LineHeight="21" Foreground="{DynamicResource MutedBrush}"/></ScrollViewer>
   </DockPanel></Border>
  </Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><TextBlock Text="{Binding T.SizeNote}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
 <Window.Resources>
  <DataTemplate x:Key="FilterPanel"><StackPanel Margin="0,0,0,12"><WrapPanel>
   <StackPanel Width="225" Margin="0,0,8,8"><TextBlock Text="{Binding T.SearchLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding T.SearchLabel}"/></StackPanel>
   <StackPanel Width="105" Margin="0,0,8,8"><TextBlock Text="{Binding T.MinimumMb}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><ComboBox IsEditable="True" ItemsSource="{Binding SizePresets}" Text="{Binding Minimum, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding T.MinimumTip}"/></StackPanel>
   <StackPanel Width="92" Margin="0,0,8,8"><TextBlock Text="{Binding T.Extension}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding T.ExtensionTip}"/></StackPanel>
   <StackPanel Width="165" Margin="0,0,8,8"><TextBlock Text="{Binding T.FileCategory}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/></StackPanel>
   <StackPanel Width="135" Margin="0,0,8,8"><TextBlock Text="{Binding T.Sorting}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding Sort}"/></StackPanel>
   <Button Content="{Binding T.Reset}" Command="{Binding ResetFiltersCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
  </WrapPanel><TextBlock Text="{Binding FilterSummary}" Style="{StaticResource Muted}" FontSize="11"/><ProgressBar IsIndeterminate="True" Height="2" Margin="0,6,0,0" Visibility="{Binding IsFiltering, Converter={StaticResource BoolVisibility}}"/></StackPanel></DataTemplate>
 </Window.Resources>
</Window>
